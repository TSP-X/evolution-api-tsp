# ============================================
# Evolution API - Railway Environment Variables
# ============================================
# Configure estas variáveis no painel do Railway:
# Project > Service > Variables

# === OBRIGATÓRIAS ===

# Chave de autenticação da API (defina uma chave forte)
AUTHENTICATION_API_KEY=TSP_GROUP_SECRET_KEY_2024

# PostgreSQL - Referência ao serviço Postgres do Railway
# Use: ${{Postgres.DATABASE_URL}}
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Redis - Referência ao serviço Redis do Railway
# Use: ${{Redis.REDIS_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# === OPCIONAIS (auto-detectadas pelo Railway) ===

# URL pública (Railway define automaticamente via RAILWAY_PUBLIC_DOMAIN)
# SERVER_URL=https://seu-dominio.up.railway.app

# Porta (Railway define automaticamente via PORT)
# PORT=8080

# === CANAIS - configurar após deploy via API ===

# Instagram - Token Meta Business
# WA_BUSINESS_TOKEN=seu-meta-access-token

# Telegram - Token do BotFather
# TELEGRAM_BOT_TOKEN=seu-telegram-bot-token
