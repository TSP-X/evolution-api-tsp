# Evolution API - Environment Variables

# Server
SERVER_URL=https://your-domain.com
AUTHENTICATION_API_KEY=your-secret-api-key

# Database (used by docker-compose for local dev)
DATABASE_URL=postgresql://evolution:evolution_pass@postgres:5432/evolution_db

# Meta Business (Instagram)
# Get from https://developers.facebook.com
WA_BUSINESS_TOKEN=your-meta-access-token

# Telegram
# Get from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
